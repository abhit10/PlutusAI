# Local PostgreSQL (create this database and user first; use your own password).
DATABASE_URL=postgresql://plutus:CHANGE_ME@127.0.0.1:5432/plutusai
DATABASE_SSL_REQUIRED=false
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave unset for the same-origin Vite proxy.
DJANGO_CORS_ALLOWED_ORIGINS=
