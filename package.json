{
  "name": "plutusai",
  "version": "0.1.0",
  "private": true,
  "description": "PlutusAI foundation: Django + DRF API and a React (Vite) SPA.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "uv run python manage.py runserver 0.0.0.0:8000",
    "dev:web": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "migrate": "uv run python manage.py migrate",
    "seed": "uv run python manage.py seed_assets"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
